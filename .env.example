# Clé API Google pour Gemini (vision et analyse)
GOOGLE_API_KEY=your_google_api_key_here

# Chemin absolu vers le vault Obsidian
OBSIDIAN_VAULT_PATH=C:/Users/YourName/Obsidian/Vault

# Chemin vers le fichier SQLite (défaut: ./agent.db)
DB_PATH=./agent.db

# Mode lecture seule (true pour désactiver toutes les actions)
READONLY_MODE=false

# Niveau de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Cerveau : gemini (cloud) ou gemma (API Google)
LLM_PROVIDER=gemma
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it
